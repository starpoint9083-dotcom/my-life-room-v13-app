</div>

<script>
let habit='금주', roomStyle='', petKind='cat', petMode='집사취급형', charStyle='나답게';
let photoData=null, candidate=1, generatedCandidates=[], selectedAvatar=null, P=3420, saved=243000, hidden=0, day='success', currentTime='morning', timerId=null, smokeBase=20, alcoholCost=45000, roomLevel=1, growthXP=18, deviceId=null, deviceToken=null, serverSyncEnabled=false, syncTimer=null, lastServerSync=0, riskProfile=null, deferredInstallPrompt=null;



const ASSET_MANIFEST = {
  rooms: {
    1: {morning:"assets/rooms/lv1_morning.webp",day:"assets/rooms/lv1_day.webp",return:"assets/rooms/lv1_return.webp",evening:"assets/rooms/lv1_evening.webp",night:"assets/rooms/lv1_night.webp"},
    2: {morning:"assets/rooms/lv2_morning.webp",day:"assets/rooms/lv2_day.webp",return:"assets/rooms/lv2_return.webp",evening:"assets/rooms/lv2_evening.webp",night:"assets/rooms/lv2_night.webp"},
    3: {morning:"assets/rooms/lv3_morning.webp",day:"assets/rooms/lv3_day.webp",return:"assets/rooms/lv3_return.webp",evening:"assets/rooms/lv3_evening.webp",night:"assets/rooms/lv3_night.webp"},
    4: {morning:"assets/rooms/lv4_morning.webp",day:"assets/rooms/lv4_day.webp",return:"assets/rooms/lv4_return.webp",evening:"assets/rooms/lv4_evening.webp",night:"assets/rooms/lv4_night.webp"}
  },
  avatar: {
    idle:"assets/avatar/idle.webp",
    morning:"assets/avatar/morning.webp",
    leave:"assets/avatar/leave.webp",
    return:"assets/avatar/return.webp",
    evening:"assets/avatar/evening.webp",
    night:"assets/avatar/night.webp"
  },
  pet: {
    "집사취급형":"assets/pets/cat_boss.webp",
    "개냥이형":"assets/pets/cat_affection.webp",
    "듬직이형":"assets/pets/dog_steady.webp",
    "댕댕이형":"assets/pets/dog_playful.webp"
  }
};

const SCENE_RULES = {
  morning:{avatar:true,pet:true,roomKey:"morning",intensity:"medium",pose:"stand"},
  leave:{avatar:true,pet:true,roomKey:"morning",intensity:"medium",pose:"stand"},
  day:{avatar:false,pet:true,roomKey:"day",intensity:"low",pose:"away"},
  return:{avatar:true,pet:true,roomKey:"return",intensity:"medium",pose:"stand"},
  evening:{avatar:true,pet:true,roomKey:"evening",intensity:"low",pose:"sit"},
  night:{avatar:true,pet:true,roomKey:"night",intensity:"low",pose:"sit"}
};

function preloadImage(src){
  return new Promise(resolve=>{
    const img=new Image();
    img.onload=()=>resolve(true);
    img.onerror=()=>resolve(false);
    img.src=src;
  });
}
async function tryAsset(imgEl,src,ownerEl){
  if(!imgEl || !src) return false;
  const ok=await preloadImage(src);
  if(ok){
    imgEl.src=src;
    if(ownerEl) ownerEl.classList.add('assetMode');
    return true;
  }
  if(ownerEl) ownerEl.classList.remove('assetMode');
  imgEl.removeAttribute('src');
  return false;
}
async function applySceneAssets(){
  const rule=SCENE_RULES[currentTime]||SCENE_RULES.evening;
  const roomEl=document.getElementById('room');
  const roomArt=document.getElementById('roomArt');
  const avatarEl=document.getElementById('avatar');
  const avatarAsset=document.getElementById('avatarAsset');
  const petEl=document.getElementById('pet');
  const petAsset=document.getElementById('petAsset');
  const roomSrc=ASSET_MANIFEST.rooms[roomLevel]?.[rule.roomKey];

  let roomOk=false,avatarOk=false,petOk=false;
  if(roomArt&&roomSrc){
    roomOk=await preloadImage(roomSrc);
    if(roomOk){roomArt.src=roomSrc;roomEl.classList.add('hasArt')}
    else{roomArt.removeAttribute('src');roomEl.classList.remove('hasArt')}
  }
  if(rule.avatar){
    avatarEl.classList.remove('away');
    avatarOk=await tryAsset(avatarAsset,ASSET_MANIFEST.avatar[currentTime]||ASSET_MANIFEST.avatar.idle,avatarEl);
  }else{
    avatarEl.classList.add('away');
  }
  if(rule.pet){
    petOk=await tryAsset(petAsset,ASSET_MANIFEST.pet[petMode],petEl);
  }

  const badge=document.getElementById('assetBadge');
  if(badge) badge.textContent=(roomOk||avatarOk||petOk)?'실제 자산 활성':'자산 슬롯 준비됨';
  roomEl.classList.remove('sceneFade');void roomEl.offsetWidth;roomEl.classList.add('sceneFade');
}
function renderHiddenProps(){
  con