</b></div>
  </div>
  <h2 style="margin-top:18px">펫</h2>
  <div class="grid2">
    <div class="option petKind active" data-v="cat">🐱<b>고양이</b></div>
    <div class="option petKind" data-v="dog">🐶<b>개</b></div>
