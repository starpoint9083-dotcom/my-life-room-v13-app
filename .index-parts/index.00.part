<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#fbfaf7">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<link rel="manifest" href="/manifest.webmanifest">
<title>나의 방 V13 - 원샷 배포 준비본</title>
<style>
:root{
 --bg:#fbfaf7;--card:#fff;--text:#222;--muted:#736e67;--line:#e9e2d8;
 --shadow:0 12px 30px rgba(48,39,31,.10);--dark:#242424;
}
*{box-sizing:border-box}
body{margin:0;background:#ddd9d4;font-family:system-ui,-apple-system,"Noto Sans KR",sans-serif;color:var(--text);display:flex;justify-content:center}
.app{width:min(100vw,440px);min-height:100vh;background:var(--bg);position:relative;overflow:hidden}
.screen{display:none;min-height:100vh;padding:17px 14px 96px}.screen.active{display:block}
h1{font-size:26px;margin:6px 0 7px;letter-spacing:-.5px}h2{font-size:20px;margin:4px 0}p{color:var(--muted);line-height:1.5;font-size:13px}
.small{font-size:11px;color:var(--muted)}
.card{background:#fff;border:1px solid var(--line);border-radius:20px;padding:14px;margin:10px 0;box-shadow:var(--shadow)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:9px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.option{border:1px solid var(--line);background:#fff;border-radius:18px;padding:14px 8px;min-height:88px;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;cursor:pointer}
.option.active{outline:3px solid #242424}
.big{width:100%;border:0;background:#242424;color:#fff;border-radius:16px;padding:14px;font-weight:800;margin-top:10px}
.big.alt{background:#fff;color:#242424;border:1px solid var(--line)}
.pill{display:inline-block;padding:8px 11px;border:1px solid var(--line);border-radius:999px;background:#fff;font-size:12px;margin:3px;cursor:pointer}
.pill.active{background:#242424;color:#fff}
.photoBox{height:235px;border:2px dashed #cfc5b9;border-radius:24px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#fbfaf8;position:relative}
.photoBox img{width:100%;height:100%;object-fit:cover}
.photoNote{position:absolute;bottom:9px;left:50%;transform:translateX(-50%);background:rgba(255,255,255,.88);padding:6px 9px;border-radius:999px;font-size:10px;white-space:nowrap}
.candidates{display:none;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}.candidates.show{display:grid}
.candidate{border:1px solid var(--line);background:#fff;border-radius:18px;padding:7px;cursor:pointer}.candidate.active{outline:3px solid #242424}
.candidate .img{aspect-ratio:3/4;border-radius:13px;overflow:hidden;background:linear-gradient(145deg,#e8ddd2,#c9b9aa);display:flex;align-items:center;justify-content:center}
.candidate img{width:100%;height:100%;object-fit:cover}
.candidate:nth-child(1) img{filter:saturate(.95) contrast(1.03)}
.candidate:nth-child(2) img{filter:brightness(1.05) saturate(1.08) contrast(.98)}
.candidate:nth-child(3) img{filter:contrast(1.08) saturate(.86)}
.candidate b{display:block;font-size:11px;margin-top:7px;text-align:center}
.heroNote{background:#f1ece5;border-radius:16px;padding:11px;font-size:11px;color:#675f57;margin-top:9px}
.aiStatus{display:none;margin-top:10px;background:#fff;border:1px solid var(--line);border-radius:15px;padding:11px;font-size:12px}
.aiStatus.show{display:block}
.spinner{display:inline-block;width:14px;height:14px;border:2px solid #ddd;border-top-color:#222;border-radius:50%;animation:spin .7s linear infinite;vertical-align:-2px;margin-right:6px}
@keyframes spin{to{transform:rotate(360deg)}}
.avatarFull{position:absolute;inset:-4px -12px -2px -12px;width:128px;height:205px;object-fit:contain;z-index:9;display:none;filter:drop-shadow(0 7px 4px rgba(0,0,0,.16))}
.avatar.ai .avatarFull{display:block}
.avatar.ai .avatarPhoto,.avatar.ai .hairFallback,.avatar.ai .body,.avatar.ai .leg{display:none}
.top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:8px}
.stat{background:#fff;border:1px solid var(--line);border-radius:14px;padding:8px 3px;text-align:center;font-size:10px}.stat b{display:block;font-size:13px;margin-top:2px}
.timeline{background:#fff;border:1px solid var(--line);border-radius:16px;padding:9px;margin-bottom:8px}
.times{display:grid;grid-template-columns:repeat(6,1fr);gap:4px}.times button{border:1px solid var(--line);background:#faf8f5;border-radius:10px;padding:7px 2px;font-size:10px}.times button.active{background:#242424;color:#fff}
.room{height:490px;border-radius:26px;position:relative;overflow:hidden;border:1px solid #d5cec5;box-shadow:var(--shadow);background:linear-gradient(#e9f5fb 0 42%,#f4e6d2 42% 100%);transition:.35s}
.room.modern{background:linear-gradient(#edf3f6 0 42%,#e9e5de 42% 100%)}.room.cozy{background:linear-gradient(#fff0e1 0 42%,#f2d7bd 42% 100%)}
.room.evening{filter:saturate(1.02) brightness(.98)}.room.night{background:linear-gradient(#5d7087 0 42%,#776f68 42% 100%)}
.room.rain:after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(110deg,transparent 0 20px,rgba(255,255,255,.18) 21px 22px);pointer-events:none}
.window{position:absolute;left:19px;top:44px;width:151px;height:144px;border:10px solid rgba(255,255,255,.9);background:linear-gradient(#d6f0ff,#fff4c9)}
.room.night .window{background:linear-gradient(#273a55,#62748a)}
.window:before,.window:after{content:"";position:absolute;background:#fff}.window:before{left:50%;width:5px;height:100%}.window:after{top:50%;height:5px;width:100%}
.sun{position:absolute;right:16px;top:14px;width:33px;height:33px;border-radius:50%;background:#fff1a5;box-shadow:0 0 23px #fff1a5}.room.night .sun{background:#f4f4ff;box-shadow:0 0 18px #dfe5ff}
.sofa{position:absolute;left:29px;bottom:128px;width:225px;height:102px;border-radius:27px;background:#c9ae91;box-shadow:0 10px 0 #aa8f74}.sofa:before{content:"";position:absolute;left:12px;top:-26px;width:201px;height:52px;border-radius:28px;background:#d7c0a5}
.rug{position:absolute;left:44px;bottom:28px;width:300px;height:84px;border-radius:50%;background:#d7bea0}
.table{position:absolute;right:21px;bottom:108px;width:101px;height:20px;background:#8e684b;border-radius:10px}.table:before,.table:after{content:"";position:absolute;top:16px;width:8px;height:56px;background:#70523d}.table:before{left:15px}.table:after{right:15px}
.plant{position:absolute;right:38px;bottom:132px;width:44px;height:94px;z-index:8;transition:.25s}.pot{position:absolute;bottom:0;width:44px;height:31px;background:#a16d4b;border-radius:5px 5px 14px 14px}
.leaf{position:absolute;width:27px;height:13px;border-radius:100% 0 100% 0;background:#719b69}.l1{left:-6px;top:34px;transform:rotate(24deg)}.l2{right:-7px;top:22px;transform:rotate(145deg)}.l3{left:4px;top:10px;transform:rotate(68deg)}.newleaf{display:none;right:-10px;top:3px;background:#8dbd82}
.avatar{position:absolute;left:140px;bottom:109px;width:104px;height:200px;z-index:12;transition:.35s;transform-origin:center bottom}.avatar.away{opacity:0;transform:translateX(120px) scale(.9);pointer-events:none}
.avatarPhoto{position:absolute;left:18px;top:0;width:68px;height:76px;border-radius:48% 48% 43% 43%;background:#efc6aa;overflow:hidden;z-index:3;border:2px solid rgba(0,0,0,.05)}.avatarPhoto img{width:100%;height:100%;object-fit:cover}
.hairFallback{position:absolute;left:11px;top:-7px;width:82px;height:50px;border-radius:55% 55% 28% 28%;background:#302b29;z-index:2}.body{position:absolute;left:13px;top:70px;width:79px;height:105px;border-radius:28px 28px 18px 18px;background:#435d69}.leg{position:absolute;top:164px;width:23px;height:35px;background:#393e43;border-radius:7px}.lleg{left:25px}.rleg{right:25px}
.pet{position:absolute;left:72px;bottom:84px;width:80px;height:61px;z-index:13;transition:.25s;transform-origin:center bottom}.dog{background:#d69e56;border-radius:50% 48% 42% 42%}.dog:before,.dog:after{content:"";position:absolute;top:-16px;width:21px;height:29px;background:#c98945}.dog:before{left:7px;transform:rotate(-18deg);border-radius:20px 5px 15px 5px}.dog:after{right:7px;transform:rotate(18deg);border-radius:5px 20px 5px 15px}
.cat{background:#aaa39d;border-radius:50% 50% 42% 42%}.cat:before,.cat:after{content:"";position:absolute;top:-14px;border-left:13px solid transparent;border-right:13px solid transparent;border-bottom:25px solid #958f8a}.cat:before{left:4px}.cat:after{right:4px}
.petface{position:absolute;left:25px;top:17px;font-size:20px}
.badge{position:absolute;top:10px;left:50%;transform:translateX(-50%);z-index:25;background:rgba(255,255,255,.95);border:1px solid var(--line);border-radius:18px;padding:7px 11px;font-size:11px;font-weight:800}
.event{position:absolute;left:10px;right:10px;bottom:10px;z-index:30;background:rgba(255,255,255,.94);border:1px solid var(--line);border-radius:14px;padding:9px 10px;font-size:11px;min-he