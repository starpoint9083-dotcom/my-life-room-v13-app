let plantN=0;
let lastHumanAction=null,lastPetAction=null;
let todayHidden=[];
let foundHiddenIds=[];



function currentPose(){
 if(currentTime==="day"||currentTime==="leave") return "stand";
 if(currentTime==="return") return "stand";
 if(currentTime==="evening"||currentTime==="night") return "sit";
 return "stand";
}
function chooseHumanAction(){
 const pose=currentPose();
 let pool=ACTIONS.filter(a=>{
   const timeOk=a.times.includes(currentTime)||a.times.includes("any");
   const poseOk=a.pose==="any"||a.pose===pose;
   const petOk=!a.pet||Boolean(petKind);
   return timeOk&&poseOk&&petOk&&a.id!==lastHumanAction;
 });
 if(!pool.length) pool=ACTIONS.filter(a=>a.id!==lastHumanAction);
 const action=pool[Math.floor(Math.random()*pool.length)];
 lastHumanAction=action.id;
 return action.label;
}
function buildPetPool(){
 const species=petKind==="cat"?CAT_COMMON:DOG_COMMON;
 let pool=[...PET_COMMON,...species,...PET_SPECIAL[petMode],...PET_EXTRA];
 // keep 50-slot behavior pool
 while(pool.length<50) pool.push(...PET_COMMON.slice(0,Math.min(PET_COMMON.length,50-pool.length)));
 return pool.slice(0,50).filter(x=>x!==lastPetAction);
}
function choosePetAction(){
 const pool=buildPetPool();
 const action=pool[Math.floor(Math.random()*pool.length)]||"조용히 쉬어요";
 lastPetAction=action;
 return action;
}
function prepareHiddenChanges(){
 const count=day==="success"?2:day==="reduce"?1:0;
 const seedPool=[...HIDDEN_CHANGES];
 todayHidden=[];
 while(todayHidden.length<count&&seedPool.length){
   const idx=Math.floor(Math.random()*seedPool.length);
   todayHidden.push(seedPool.splice(idx,1)[0]);
 }
 foundHiddenIds=[];
 renderHiddenSummary();
 setTimeout(renderHiddenProps,0);
}
function renderHiddenSummary(){
 const el=document.getElementById("hiddenCount");
 if(el) el.textContent=HIDDEN_CHANGES.length;
}
function discoverHidden(source){
 if(!todayHidden.length||day==="slip") return null;
 const next=todayHidden.find(x=>!foundHiddenIds.includes(x.id));
 if(!next) return null;
 foundHiddenIds.push(next.id);
 hidden=foundHiddenIds.length;
 badge();
 setTimeout(renderHiddenProps,0);
 return next;
}
function engineStateText(){
 if(currentTime==="day") return "외출 중 · 펫/방 활성";
 if(currentTime==="night") return "야간 · 저강도";
 if(day==="slip") return "회복 모드";
 return "생활 모드";
}
function refreshEngineState(){
 const e=document.getElementById("engineState");
 if(e) e.textContent=engineStateText();
 const h=document.getElementById("humanCount");if(h)h.textContent=ACTIONS.length;
 const p=document.getElementById("petCount");if(p)p.textContent=50;
 const c=document.getElementById("hiddenCount");if(c)c.textContent=HIDDEN_CHANGES.length;
}


