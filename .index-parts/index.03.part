st ids=['hp1','hp2','hp3'];
  ids.forEach((id,i)=>{
    const el=document.getElementById(id);
    if(!el)return;
    const visible=i<Math.min(todayHidden.length,3)&&!foundHiddenIds.includes(todayHidden[i]?.id)&&day!=='slip';
    el.classList.toggle('show',visible);
    el.onclick=()=>{
      const change=discoverHidden('prop');
      if(change)show('✨ 발견: '+change.label);
      renderHiddenProps();
    };
  });
}

