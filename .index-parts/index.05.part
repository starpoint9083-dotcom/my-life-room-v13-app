anvas');c.width=w;c.height=h;
      c.getContext('2d').drawImage(img,0,0,w,h);
      c.toBlob(b=>b?resolve(b):reject(new Error('사진 변환 실패')),'image/jpeg',.90);
    };
    img.onerror=()=>reject(new Error('사진을 읽지 못했습니다.'));
    img.src=dataUrl;
  });
}
function setAIStatus(msg,loading=false){
  const el=document.getElementById('aiStatus');
  el.classList.add('show');
  el.innerHTML=(loading?'<span class="spinner"></span>':'')+msg;
}
function renderCandidateImages(images){
  const boxes=document.querySelectorAll('.candidate .img');
  boxes.forEach((el,i)=>{
    el.innerHTML='';
    const img=document.createElement('img');
    img.src=images[i] || photoData || '';
    img.alt='본캐 후보 '+(i+1);
    el.appendChild(img);
  });
  document.getElementById('candidates').classList.add('show');
  document.getElementById('characterNext').style.display='block';
}
async function generateCandidates(){
  const btn=document.getElementById('generateBtn');
  btn.disabled=true;
  try{
    if(!photoData){
      setAIStatus('사진이 없어 데모 얼굴로 먼저 확인합니다.');
      generatedCandidates=['','',''];
      document.querySelectorAll('.candidate .img').forEach((el,i)=>{
        el.innerHTML='<div style="font-size:42px">'+['🙂','😊','😎'][i]+'</div>';
      });
      document.getElementById('candidates').classList.add('show');
      document.getElementById('characterNext').style.display='block';
      return;
    }

    if(location.protocol==='file:'){
      generatedCandidates=[photoData,photoData,photoData];
      renderCandidateImages(generatedCandidates);
      setAIStatus('지금은 휴대폰 로컬 데모입니다. Cloudflare 배포 주소에서 열면 실제 AI 후보 3장이 생성됩니다.');
      return;
    }

    setAIStatus('사진을 안전한 크기로 줄인 뒤 본캐 후보 3개를 만들고 있어요…',true);
    const blob=await resizeSelfieForAI(photoData);
    const fd=new FormData();
    fd.append('image',blob,'selfie.jpg');
    fd.append('style',charStyle);

    const res=await fetch('/api/avatar/generate',{method:'POST',body:fd});
    const data=await res.json().catch(()=>({}));
    if(!res.ok || !data.ok) throw new Error(data.error || 'AI 생성 요청 실패');

    generatedCandidates=data.images || [];
    if(generatedCandidates.length!==3) throw new Error('후보 3장을 모두 받지 못했습니다.');
    renderCandidateImages(generatedCandidates);
    candidate=1;
    selectedAvatar=generatedCandidates[0];
    document.querySelectorAll('.candidate').forEach((x,i)=>x.classList.toggle('active',i===0));
    setAIStatus('후보 3개가 완성됐어요. 마음에 드는 본캐를 한 명 고르세요.');
  }catch(err){
    setAIStatus('생성 오류: '+err.message+' — 사진은 그대로 보존됩니다.');
  }finally{
    btn.disabled=false;
  }
}
function pickCandidate(n,el){
  candidate=n;
  document.querySelectorAll('.candidate').forEach(x=>x.classList.remove('active'));
  el.classList.add('active');
  selectedAvatar=generatedCandidates[n-1] || photoData || null;
  toast(`후보 ${n} 선택됨`);
}

function go(id){document.querySelectorAll('.screen').forEach(x=>x.classList.remove('active'));document.getElementById(id).classList.add('active');window.scrollTo(0,0)}
function saveState(){
  smokeBase=Number(document.getElementById('smokeBase')?.value||smokeBase);
  alcoholCost=Number(document.getElementById('alcoholCost')?.value||alcoholCost);
  storageSet('myroomV13',JSON.stringify({
    habit,roomStyle,petKind,petMode,charStyle,photoData,candidate,selectedAvatar,
    P,saved,day,currentTime,smokeBase,alcoholCost,roomLevel,growthXP,todayHidden,foundHiddenIds
  }));
  scheduleServerSync('state-change');
}
function loadState(){
  try{
    const s=JSON.parse(storageGet('myroomV13')||'null');
    if(!s)return false;
    habit=s.habit||habit;
    roomStyle=s.roomStyle!==undefined?s.roomStyle:roomStyle;
    petKind=s.petKind||petKind;
    petMode=s.petMode||petMode;
    charStyle=s.charStyle||charStyle;
    photoData=s.photoData||null;
    candidate=s.candidate||1;
    selectedAvatar=s.selectedAvatar||null;
    P=s.P??P;saved=s.saved??saved;day=s.day||day;currentTime=s.currentTime||currentTime;
    smokeBase=s.smokeBase||smokeBase;alcoholCost=s.alcoholCost||alcoholCost;
    roomLevel=s.roomLevel||roomLevel;growthXP=s.growthXP??growthXP;
    todayHidden=Array.isArray(s.todayHidden)?s.todayHidden:todayHidden;
    foundHiddenIds=Array.isArray(s.foundHiddenIds)?s.foundHiddenIds:foundHiddenIds;
    return true;
  }catch(e){return false}
}
async function finishSetup(){smokeBase=Number(document.getElementById('smokeBase')?.value||smokeBase);alcoholCost=Number(document.getElementById('alcoholCost')?.value||alcoholCost);
      if(!selectedAvatar && generatedCandidates.length) selectedAvatar=generatedCandidates[candidate-1]||generatedCandidates[0];
      if(!selectedAvatar) selectedAvatar=photoData;
      saveState();go('home');document.getElementById('nav').classList.add('show');applyHome();firstThree();
      if(location.protocol!=='file:' && selectedAvatar) saveMasterToServer(selectedAvatar);
    }
    async function saveMasterToServer(dataUrl){
      try{
        ensureDeviceIdentity();
        const blob=await (await fetch(dataUrl)).blob();
        const fd=new FormData();
        fd.append('image',blob,'master.jpg');
        fd.append('style',charStyle);
        fd.append('device_id',deviceId);fd.append('device_token',deviceToken);
        const r=await fetch('/api/avatar/save',{method:'POST',body:fd});
        const d=await r.json().catch(()=>({}));
        if(d.stored&&d.key){
          storageSet('myroomAvatarKey',d.key);
          scheduleServerSync('avatar-saved');
          show('✅ 선택한 본캐를 저장했습니다. 이제 이 얼굴을 기준으로 재사용합니다.');
        }
      }catch(e){}
    }
function applyHome(){
 const room=document.getElementById('room');room.className='room '+roomStyle;
 const pet=document.getElementById('pet');pet.className='pet '+(petKind==='cat'?'cat':'dog');
 const a=document.getElementById('avatar'),full=document.getElementById('avatarFull'),ph=document.getElementById('avatarPhoto');
 ph.innerHTML='';
 if(selectedAvatar){
   a.classList.add('ai');full.src=selectedAvatar;
 }else{
   a.classList.remove('ai');full.removeAttribute('src');
   if(photoData){const i=document.createElement('img');i.src=photoData;ph.appendChild(i)}
 }
 applyRoomLevel();if(!todayHidden.length)prepareHiddenChanges();refreshEngineState();updateStats();autoTime()
}

function applyRoomLevel(){
 const room=document.getElementById('room');
 room.classList.remove('level1','level2','level3','level4');
 room.classList.add('level'+roomLevel);
 const titles=['','Lv.1 기본방','Lv.2 성장방','Lv.3 좋은 집','Lv.4 프리미엄방'];
 const hints=['','시작하기 충분한 공간','꾸준함이 보이기 시작했어요','내 삶이 꽤 달라졌어요','내가 만들어낸 최고의 공간'];
 const title=document.getElementById('levelTitle'),hint=document.getElementById('levelHint'),fill=document.getElementById('progressFill');
 if(title) title.textContent=titles[roomLevel];
 if(hint) hint.textContent=hints[roomLevel];
 if(fill) fill.style.width=Math.min(100,growthXP)+'%';
 document.querySelectorAll('.levels button').forEach((b,i)=>b.classList.toggle('active',i===roomLevel-1));
 applySceneAssets();
}
function previewLevel(n,btn){
 roomLevel=n;
 growthXP=[18,42,72,100][n-1];
 applyRoomLevel();
 show(['','아직 비어 있지만 시작하기 좋은 밝은 기본방입니다.','작은 변화와 소품이 쌓여 방이 살아나기 시작합니다.','공간이 넓어지고 가구와 빛이 더 좋아졌습니다.','꾸준함과 꾸미기가 쌓여 프리미엄 공간까지 성장했습니다.'][n]);
 saveState();
}
function addGrowth(amount,reason){
 growthXP=Math.min(100,growthXP+amount);
 if(growthXP>=90) roomLevel=4;
 else if(growthXP>=60) roomLevel=3;
 else if(growthXP>=30) roomLevel=2;
 else roomLevel=1;
 applyRoomLevel();
 saveState();
 if(reason) toast(reason);
}

function updateStats(){document.getElementById('points').textContent=P.toLocaleString()+'P';document.getElementById('saved').textContent=saved.toLocaleString()+'원';saveState()}
function resetAll(){storageDel('myroomV13');storageDel('myroomAvatarKey');logEvent('reset',{});location.reload()}
function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(window.tt);window.tt=setTimeout(()=>t.classList.remove('show'),2100)}
function show(msg){document.getElementById('event').textContent=msg}
function rand(a){return a[Math.floor(Math.random()*a.length)]}
function anim(el,c){el.classList.remove('bob','wig','nod');void el.offsetWidth;el.classList.add(c)}
function avatarTap(){
  const avatar=document.getElementById('avatar');
  if(avatar.classList.contains('away')){
    show('본캐는 지금 출근 중이에요.');
    return;
  }
  anim(avatar,rand(['bob','wig','nod']));
  show('🙂 '+chooseHumanAction());
}
function petTap(){
  const pet=document.getElementById('pet');
  anim(pet,rand(['bob','wig']));
  const action=choosePetAction();
  const hiddenChange=discoverHidden('pet');
  show('🐾 '+action+(hiddenChange?' · 발견: '+hiddenChange.label:''));renderHiddenProps();
}
